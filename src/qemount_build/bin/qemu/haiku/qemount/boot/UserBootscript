#!/bin/sh

LOG=/boot/home/qemount.log
DEBUG_SERIAL=/dev/ports/pc_serial0
SERIAL=/dev/ports/pc_serial1
SIMPLE9P=/boot/system/non-packaged/bin/simple9p

exec >>"$LOG" 2>&1

qemount_log()
{
    echo "qemount: $*"
    if [ -e "$DEBUG_SERIAL" ]; then
        echo "qemount: $*" > "$DEBUG_SERIAL"
    fi
}

qemount_log "UserBootscript started"
for port in /dev/ports/*; do
    qemount_log "serial device $port"
done

qemount_log "waiting for second serial port"
while [ ! -e "$SERIAL" ]; do
    sleep 1
done

qemount_log "mounting detected volumes"
/bin/mountvolume -all
/bin/mountvolume -l

while true; do
    qemount_log "serving / over $SERIAL"
    "$SIMPLE9P" -p "stream!$SERIAL" /
    status=$?
    qemount_log "simple9p exited with status $status; restarting"
    sleep 1
done
