# DragonFly kernel for the qemount QEMU filesystem appliance.

platform	pc64
machine		x86_64
machine_arch	x86_64
cpu		HAMMER_CPU
ident		QEMOUNT
maxusers	0

options		HAMMER
options		HAMMER2
options		FFS
options		SOFTUPDATES
options		UFS_DIRHASH
options		TMPFS
options		MSDOSFS
options		CD9660
options		SCSI_DELAY=100
options		UCONSOLE

device		isa
device		pci
device		ahci

device		scbus
device		da
device		cd
device		pass

device		virtio
device		virtio_blk

device		sio0	at isa? port IO_COM1 flags 0x10 irq 4

pseudo-device	pty
pseudo-device	md
pseudo-device	vn
