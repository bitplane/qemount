#!/bin/rc

# The appliance needs only the storage and UART devices.  The general-purpose
# termrc also starts networking, USB, graphics, DNS and timesync services.
for(i in S t)
	bind -qa '#'^$i /dev
mount -qb /srv/cons /dev >[2]/dev/null

echo '[mountin] starting appliance'
. /rc/bin/mountin

echo '[mountin] starting diagnostic shell'
prompt=('term% ' '	')
fn term%{ $* }
/bin/rc </dev/cons >/dev/cons >[2=1]
