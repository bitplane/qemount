Echo "Formatting DH0: as PFS3" >SER:
SYS:System/Format DRIVE DH0: NAME TestPFS QUICK NOICONS <SYS:format-confirm
If WARN
    Echo "Formatting DH0: failed" >SER:
    C:Shutdown
EndIf

Echo "Populating DH0: from the test-data manifest" >SER:
C:Execute SYS:populate
If WARN
    Echo "Populating DH0: failed" >SER:
    C:Shutdown
EndIf

Echo "Dismounting DH0: to flush the fixture" >SER:
C:Assign DH0: DISMOUNT
If WARN
    Echo "Dismounting DH0: failed" >SER:
    C:Shutdown
EndIf

Echo "PFS3 fixture complete" >SER:
C:Shutdown
