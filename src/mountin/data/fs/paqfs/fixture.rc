#!/bin/rc

mkpaqfs -l MOUNTIN -o /n/mountin/basic.paqfs /n/mountin-fixture/TestData/basic
command_status=$status
if(! ~ $"command_status '') exit failure
paqfs -v -m /n/paq-verify /n/mountin/basic.paqfs
command_status=$status
if(! ~ $"command_status '') exit failure
test -f /n/paq-verify/hello.txt
command_status=$status
if(! ~ $"command_status '') exit failure
unmount /n/paq-verify
command_status=$status
if(! ~ $"command_status '') exit failure
unmount /n/mountin
