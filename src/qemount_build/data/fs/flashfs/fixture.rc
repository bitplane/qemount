#!/bin/rc

aux/mkflashfs -n 512 -z 4096 /dev/sdF0/data
command_status=$status
if(! ~ $"command_status '') {
	echo mkflashfs failed: $command_status
	exit failure
}
mkdir -p /n/flash-verify
aux/flashfs -n 512 -z 4096 -f /dev/sdF0/data -m /n/flash-verify
command_status=$status
if(! ~ $"command_status '') exit failure
cd /n/flash-verify
tar xf /n/qemount-fixture/basic.tar
command_status=$status
if(! ~ $"command_status '') exit failure
test -f /n/flash-verify/basic/hello.txt
command_status=$status
if(! ~ $"command_status '') exit failure
unmount /n/flash-verify
