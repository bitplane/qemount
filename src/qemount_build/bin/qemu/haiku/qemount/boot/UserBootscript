#!/bin/sh

LOG=/boot/home/qemount.log
SERIAL=/dev/ports/pc_serial0
SIMPLE9P=/boot/system/non-packaged/bin/simple9p

exec >>"$LOG" 2>&1

qemount_log()
{
    echo "qemount: $*"
    echo "qemount: $*" > /dev/dprintf
}

qemount_log "UserBootscript started"
for port in /dev/ports/*; do
    qemount_log "serial device $port"
done

qemount_log "waiting for serial port"
while [ ! -e "$SERIAL" ]; do
    sleep 1
done

qemount_log "mounting detected volumes"
(
    /bin/mountvolume -all > /dev/dprintf 2>&1
    qemount_log "read-write mount pass exited with status $?"
    /bin/mountvolume -all -ro > /dev/dprintf 2>&1
    qemount_log "read-only mount pass exited with status $?"
) &

while true; do
    qemount_log "serving / over $SERIAL"
    "$SIMPLE9P" -p "stream!$SERIAL" /
    status=$?
    qemount_log "simple9p exited with status $status; restarting"
    sleep 1
done
