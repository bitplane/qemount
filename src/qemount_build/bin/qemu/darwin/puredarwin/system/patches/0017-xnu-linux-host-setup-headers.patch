diff --git a/src/Kernel/xnu/CMakeLists.txt b/src/Kernel/xnu/CMakeLists.txt
index a82c5b5..21306b0 100644
--- a/src/Kernel/xnu/CMakeLists.txt
+++ b/src/Kernel/xnu/CMakeLists.txt
@@ -11,5 +11,6 @@ set(xnu_make_environment
     PLATFORM=MacOSX
     HOST_OS_VERSION=11.0
+    PUREDARWIN_HOST_CCTOOLS_INCLUDE=${PUREDARWIN_SOURCE_DIR}/tools/cctools/include
 )
 
