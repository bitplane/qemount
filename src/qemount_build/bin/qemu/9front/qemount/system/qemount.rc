#!/bin/rc

qemount_disk=`{cat '#ec/qemountdisk'}
qemount_channel=`{cat '#ec/qemountchannel'}
echo '[qemount] disk' $qemount_disk 'channel' $qemount_channel

/rc/bin/qemount-mount $qemount_disk

echo b115200 > $qemount_channel^ctl

fn qemount_export {
	echo '[qemount] export ready'
	exec exportfs -r /
}

if(~ $qemount_channel /dev/eia0)
	qemount_export <>$qemount_channel >[1=0]

qemount_export <>$qemount_channel >[1=0] &
