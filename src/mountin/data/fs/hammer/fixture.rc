#!/bin/sh
set -eu

mountpoint=/tmp/mountin-fixture

newfs_hammer -f -u 8M -L MOUNTIN_HAMMER /dev/vbd0
mkdir -p "$mountpoint"
mount -t hammer /dev/vbd0 "$mountpoint"
cp -Rp /TestData/. "$mountpoint"/
sync
umount "$mountpoint"
mount -t hammer /dev/vbd0 "$mountpoint"
test "$(cat "$mountpoint/basic/hello.txt")" = "Hello, world!"
umount "$mountpoint"
echo "HAMMER fixture complete"
shutdown -p now
