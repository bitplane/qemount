 {
+#ifdef PUREDARWIN_HOST
+	return pthread_barrier_wait(&bar->bar) == PTHREAD_BARRIER_SERIAL_THREAD;
+#else
 	pthread_mutex_lock(&bar->bar_lock);
 
 	if (++bar->bar_numin < bar->bar_nthr) {
