#!/bin/sh
# PROVIDE: qemount_fixture
# REQUIRE: LOGIN

. /etc/rc.subr

name=qemount_fixture
start_cmd=qemount_fixture_start
stop_cmd=:

qemount_fixture_start()
{
    mountpoint=/tmp/qemount-fixture

    newfs_hammer2 -b 8M -r 8M -L QEMOUNT_HAMMER2 /dev/vbd0
    mkdir -p "$mountpoint"
    mount -t hammer2 /dev/vbd0@QEMOUNT_HAMMER2 "$mountpoint"
    cp -Rp /TestData/. "$mountpoint"/
    sync
    umount "$mountpoint"
    mount -t hammer2 /dev/vbd0@QEMOUNT_HAMMER2 "$mountpoint"
    test "$(cat "$mountpoint/basic/hello.txt")" = "Hello, world!"
    umount "$mountpoint"
    echo "HAMMER2 fixture complete"
    shutdown -p now
}

load_rc_config "$name"
run_rc_command "$1"
