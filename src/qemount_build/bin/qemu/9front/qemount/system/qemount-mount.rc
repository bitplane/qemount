#!/bin/rc

if(! ~ $#* 1) {
	echo 'usage: qemount-mount disk' >[1=2]
	exit usage
}

qemount_disk=$1

# Discover partitions on the one attached target disk. diskparts asks the
# native EFI, FDISK and Plan 9 partition readers to publish their partitions
# beneath the target device.
diskparts $qemount_disk

mkdir -p /mnt /tmp
ramfs -m /tmp

# DOS and ISO9660 servers can serve several devices through attach specs, so
# keep one instance of each for all candidates.
dossrv -r qemountdos
9660srv qemountiso

qemount_parts=($qemount_disk/data)
for(qemount_dev in $qemount_disk/*) {
	qemount_name=`{basename $qemount_dev}
	if(! ~ $qemount_name ctl data raw)
		qemount_parts=($qemount_parts $qemount_dev)
}

qemount_index=0
qemount_mounts=()

fn qemount_mounted {
	echo '[qemount] mounted' $qemount_dev 'at' $qemount_mnt \
		'('^$qemount_type^')'
	qemount_done=yes
	qemount_mounts=($qemount_mounts $qemount_mnt)
}

fn qemount_cleanup {
	unmount $qemount_mnt >[2]/dev/null
	rmdir $qemount_mnt >[2]/dev/null
	mkdir -p $qemount_mnt
}

for(qemount_dev in $qemount_parts) {
	qemount_name=`{basename $qemount_dev}
	qemount_mnt=/mnt/$qemount_name
	qemount_done=no
	qemount_index=$qemount_index^x
	mkdir -p $qemount_mnt

	# Servers with strong, non-destructive validation go first.
	if(~ $qemount_done no) {
		if(mount /srv/qemountiso $qemount_mnt $qemount_dev >[2]/dev/null) {
			qemount_type=iso9660
			qemount_mounted
		}
	}
	if(~ $qemount_done no) {
		qemount_cleanup
		if(mount /srv/qemountdos $qemount_mnt $qemount_dev >[2]/dev/null) {
			qemount_type=fat
			qemount_mounted
		}
	}
	if(~ $qemount_done no) {
		qemount_cleanup
		if(paqfs -q -v -m $qemount_mnt $qemount_dev >[2]/dev/null) {
			qemount_type=paqfs
			qemount_mounted
		}
	}
	if(~ $qemount_done no) {
		qemount_cleanup
		if(aux/flashfs -r -f $qemount_dev -m $qemount_mnt >[2]/dev/null) {
			qemount_type=flashfs
			qemount_mounted
		}
	}

	# GEFS has a read-only server mode and validates its root while starting.
	if(~ $qemount_done no) {
		qemount_cleanup
		qemount_srv=qemountgefs$qemount_index
		if(gefs -A -S -R -m 16 -t 0 -f $qemount_dev \
			-n $qemount_srv >[2]/dev/null) {
			if(mount /srv/$qemount_srv $qemount_mnt %main \
				>[2]/dev/null) {
				qemount_type=gefs
				qemount_mounted
			}
		}
		if(~ $qemount_done no && test -e /srv/$qemount_srv.cmd)
			echo halt >>/srv/$qemount_srv.cmd
	}

	# The tapefs readers do not validate their input, so select one only after
	# the appliance probe has validated its root inode and directory entries.
	if(~ $qemount_done no) {
		qemount_cleanup
		qemount_type=`{qemount-fsprobe $qemount_dev}
		qemount_reader_status=failure
		switch($qemount_type) {
		case v6
			fs/v6fs -m $qemount_mnt $qemount_dev >[2]/dev/null
			qemount_reader_status=$status
		case 32v
			fs/32vfs -m $qemount_mnt $qemount_dev >[2]/dev/null
			qemount_reader_status=$status
		case v10
			fs/v10fs -m $qemount_mnt $qemount_dev >[2]/dev/null
			qemount_reader_status=$status
		}
		if(~ $"qemount_reader_status '') {
			qemount_mounted
		}
	}

	# HJFS validates its superblock while starting. It has no read-only mode,
	# so keep it after the read-only probes and never invoke its ream option.
	if(~ $qemount_done no) {
		qemount_cleanup
		qemount_srv=qemounthjfs$qemount_index
		if(hjfs -f $qemount_dev -n $qemount_srv -S -m 16 \
			>[2]/dev/null) {
			if(mount /srv/$qemount_srv $qemount_mnt >[2]/dev/null) {
				qemount_type=hjfs
				qemount_mounted
			}
		}
		if(~ $qemount_done no && test -e /srv/$qemount_srv.cmd)
			echo halt >>/srv/$qemount_srv.cmd
	}

	# CWFS has no reliable raw signature. Only try it when a Plan 9 partition
	# name identifies the candidate as a CWFS device.
	if(~ $qemount_done no && ~ $qemount_name cwfs cwfs.* worm worm.*) {
		qemount_cleanup
		qemount_srv=qemountcwfs$qemount_index
		qemount_map=/tmp/$qemount_srv.map
		echo 'w0' $qemount_dev >$qemount_map
		if(cwfs64x -n $qemount_srv -m $qemount_map -f w0 \
			>[2]/dev/null) {
			echo 'users default' >>/srv/$qemount_srv.cmd
			echo 'newuser glenda' >>/srv/$qemount_srv.cmd
			sleep 1
			if(mount /srv/$qemount_srv $qemount_mnt main >[2]/dev/null) {
				qemount_type=cwfs
				qemount_mounted
			}
		}
	}

	if(~ $qemount_done no) {
		qemount_cleanup
		rmdir $qemount_mnt >[2]/dev/null
		echo '[qemount] unrecognised volume:' $qemount_dev
	}
}

if(~ $#qemount_mounts 0)
	echo '[qemount] no mountable volumes found'
