diff --git a/src/Kernel/xnu/SETUP/kextsymboltool/Makefile b/src/Kernel/xnu/SETUP/kextsymboltool/Makefile
index 7aa899d..b95e4dc 100644
--- a/src/Kernel/xnu/SETUP/kextsymboltool/Makefile
+++ b/src/Kernel/xnu/SETUP/kextsymboltool/Makefile
@@ -9,6 +9,9 @@ include $(MakeInc_def)
 OBJS = kextsymboltool.o
 
 CFLAGS = -isysroot $(HOST_SDKROOT) -mmacosx-version-min=$(HOST_OS_VERSION) -g -O0 -I$(SOURCE) -I.
+ifneq ($(PUREDARWIN_HOST_CCTOOLS_INCLUDE),)
+CFLAGS += -I$(PUREDARWIN_HOST_CCTOOLS_INCLUDE) -I$(PUREDARWIN_HOST_CCTOOLS_INCLUDE)/foreign
+endif
 
 WARNFLAGS = -Wall
 
